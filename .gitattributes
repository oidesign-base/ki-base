# Normalize all text files to LF - the panel runs on a Linux server
* text=auto eol=lf

# Windows batch files must keep CRLF, otherwise cmd.exe misreads them
*.bat text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary
*.gz   binary
